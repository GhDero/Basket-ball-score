  "modificationTime": 1748822400,
  "template": [{ "name": "t.html" }],
  "out": [
    { "name": "homeScore", "format": "Count_Fourdigits", "log": true, "shownName": "Home Score" },
    { "name": "awayScore", "format": "Count_Fourdigits", "log": true, "shownName": "Away Score" },
    { "name": "activeTeam" },
    { "name": "indHome" },
    { "name": "indAway" }
  ]
}